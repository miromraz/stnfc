# Maintainer: miromraz <noreply@example.com>
pkgname=stnfc
pkgver=0.1.0
pkgrel=0
pkgdesc="Userspace NFC toolkit for the Google Pixel 4a's ST21NFC contactless front-end"
url="https://github.com/miromraz/stnfc"
arch="aarch64"
license="GPL-2.0-or-later"
depends="
	py3-gobject3
	gtk4.0
	libadwaita
"
makedepends="musl-dev linux-headers"
options="!check"
source="
	stnfc.c
	stnfc_gui.py
	io.github.miromraz.stnfc.desktop
"
builddir="$srcdir"

build() {
	cd "$srcdir"
	${CC:-gcc} ${CFLAGS:--O2} -Wall -o stnfc stnfc.c
}

package() {
	cd "$srcdir"

	install -Dm755 stnfc "$pkgdir"/usr/bin/stnfc
	install -Dm755 stnfc_gui.py "$pkgdir"/usr/bin/stnfc-gui
	install -Dm644 io.github.miromraz.stnfc.desktop \
		"$pkgdir"/usr/share/applications/io.github.miromraz.stnfc.desktop

	install -dm755 "$pkgdir"/etc/sudoers.d
	cat > "$pkgdir"/etc/sudoers.d/stnfc <<-'SUDO'
		%wheel ALL=(root) NOPASSWD: /usr/bin/stnfc
	SUDO
	chmod 0440 "$pkgdir"/etc/sudoers.d/stnfc
}

